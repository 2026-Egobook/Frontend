<resources>
    <style name="Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="MonthPickerTextStyle">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cos_black</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>

        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="CalendarTitleTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark_bage_text</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
    </style>

    <style name="ShapeAppearance.App.OnboardingCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>


    <style name="StoreTabTextSize" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12dp</item>
        <item name="fontFamily">@font/arita_semibold</item>
    </style>

    <!-- 흰색 테두리 Material 버튼 스타일 -->
    <style name="Widget.App.Button.Outlined.White" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/cos_black</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
    </style>

    <style name="LoginButtonStyle1" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="cornerRadius">99dp</item>

        <item name="android:textColor">@color/cos_black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>

        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>

        <item name="android:elevation">0dp</item>
    </style>

    <style name="LoginButtonStyle2" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/cos_light_grey</item>
        <item name="cornerRadius">99dp</item>

        <item name="android:textColor">@color/cos_black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>

        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>

        <item name="android:elevation">0dp</item>
    </style>

    <style name="SaveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/selector_able_disable</item>
        <item name="cornerRadius">4dp</item>

        <item name="android:textColor">@color/selector_able_diable_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="MonthPickerMaterialButtonStyle">
        <item name="android:layout_width">85dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/neutral</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
    </style>
    
    <style name="ModifyButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/neutral</item>
        <item name="cornerRadius">4dp</item>

        <item name="android:textColor">@color/neutral_contrast</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="DeleteButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/neutral_weak</item>
        <item name="cornerRadius">4dp</item>

        <item name="android:textColor">@color/cos_black</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <style name="IntegrateButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/layer_white</item>
        <item name="strokeColor">@color/neutral_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">4dp</item>

        <item name="android:textColor">@color/cos_black</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="RedButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/cos_red_delete</item>
        <item name="cornerRadius">4dp</item>

        <item name="android:textColor">@color/neutral_contrast</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <!-- 날짜 입력 EditText 스타일 -->
    <style name="DatePickerEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">4</item> <!-- YYYY -->
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:textColor">@color/cos_black</item>
    </style>

    <!-- 날짜 구분자(.) 스타일 -->
    <style name="DatePickerSeparatorStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/arita_semibold</item>
        <item name="android:textColor">@color/cos_black</item>
    </style>


</resources>