<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 배경이 될 전체 회색 테두리를 그립니다. -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/cos_grey" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 2. 위에서 그린 테두리 위에 하얀색 배경을 겹칩니다. -->
    <!--    하단(bottom)에만 1dp의 여백을 주어 아래쪽 테두리가 보이도록 하고, 나머지는 덮습니다. -->
    <!--    반대로, 하단 테두리만 덮고 싶다면 bottom 값을 0dp 보다 크게 주면 됩니다.  -->
    <!--    하지만 가장 간단한 방법은 하얀색 사각형으로 하단 테두리를 덮는 것입니다. -->

    <!-- 2. 하단 테두리를 덮을 하얀색 배경 -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp"/>
        </shape>
    </item>
</layer-list>