<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_navigation"
    app:startDestination="@id/onboardingContainerFragment">

    <fragment
        android:id="@+id/menu_home"
        android:name="com.example.egobook.ui.home.HomeFragment"
        android:label="홈" >
        <action
            android:id="@+id/action_homeFragment_to_storeFragment"
            app:destination="@id/storeFragment" />
    </fragment>

    <fragment
        android:id="@+id/menu_diary"
        android:name="com.example.egobook.ui.diary.DiaryFragment"
        android:label="감정일기">
        <!-- diaryWriteFragment로의 이동 액션 추가 -->
        <action
            android:id="@+id/action_diaryFragment_to_diaryWriteFragment"
            app:destination="@id/diaryWriteFragment" />
        <!-- CandlerFragment로의 이동 액션 추가 -->
        <action
            android:id="@+id/action_diaryFragment_to_candlerFragment"
            app:destination="@id/candlerFragment" />
    </fragment>
    <fragment
        android:id="@+id/menu_ego_room"
        android:name="com.example.egobook.ui.counseling.view.EgoRoomFragment"
        android:label="에고룸"
        tools:layout="@layout/fragment_ego_room">
        <action
            android:id="@+id/action_menu_ego_room_to_counselingWeeklyReportDetailFragment"
            app:destination="@id/egoRoomWeeklyReportDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/menu_square"
        android:name="com.example.egobook.ui.square.SquareFragment"
        android:label="광장"
        tools:layout="@layout/fragment_square"/>

    <!-- diaryWriteFragment로의 목적지 정의 -->
    <fragment
        android:id="@+id/diaryWriteFragment"
        android:name="com.example.egobook.ui.diary.DiaryWriteFragment"
        android:label="일기 작성" />

    <!-- CandlerFragment로의 목적지 정의 -->
    <fragment
        android:id="@+id/candlerFragment"
        android:name="com.example.egobook.ui.diary.CandlerFragment"
        android:label="달력 화면" />
     
    <fragment
        android:id="@+id/egoRoomWeeklyReportFragment"
        android:name="com.example.egobook.ui.counseling.view.EgoRoomWeeklyReportFragment"
        android:label="fragment_counseling_weekly_report"
        tools:layout="@layout/fragment_ego_room_weekly_report" >
    </fragment>
    <fragment
        android:id="@+id/egoRoomWeeklyReportDetailFragment"
        android:name="com.example.egobook.ui.counseling.view.EgoRoomWeeklyReportDetailFragment"
        android:label="CounselingWeeklyReportDetailFragment"
        tools:layout="@layout/fragment_ego_room_weekly_report_detail">
        <argument app:argType="com.example.egobook.ui.counseling.model.WeeklyReportModel"
            android:name="weeklyReportItem"
            app:nullable="false"/>
    </fragment>

    <!-- OnboardingContainerFragment로의 목적지 정의 -->
    <fragment
        android:id="@+id/onboardingContainerFragment"
        android:name="com.example.egobook.ui.onboarding.view.OnboardingContainerFragment"
        android:label="온보딩"
        tools:layout="@layout/fragment_onboarding_container">
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/menu_home"
            app:popUpTo="@id/onboardingContainerFragment"
            app:popUpToInclusive="true" />
    </fragment>



    <fragment
        android:id="@+id/storeFragment"
        android:name="com.example.egobook.ui.shop.StoreFragment" >

        <action
            android:id="@+id/action_storeFragment_to_homeFragment"
            app:popUpTo="@id/menu_home"
            app:destination="@id/menu_home" />
    </fragment>
    <fragment
        android:id="@+id/letterReplyFragment"
        android:name="com.example.egobook.ui.square.LetterReplyFragment"
        android:label="fragment_letter_reply"
        tools:layout="@layout/fragment_letter_reply" />

</navigation>
