<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Thin: 100 -->
    <font
        app:fontStyle="normal"
        app:fontWeight="100"
        app:font="@font/arita_thin" />

    <!-- Light: 300 -->
    <font
        app:fontStyle="normal"
        app:fontWeight="300"
        app:font="@font/arita_light" />

    <!-- Medium: 500 (이미지의 medium/m, s, lg 대응) -->
    <font
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/arita_medium" />

    <!-- SemiBold: 600 (이미지의 Date, semibold/m, s, lg, xl 대응) -->
    <font
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/arita_semibold" />

    <!-- Bold: 700 -->
    <font
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/arita_bold" />

</font-family>