<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_round_and_white_dialog"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_premium_letter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="편지지를 구매하시겠어요?"
        android:textColor="@color/neutral"
        android:textSize="16sp"
        android:fontFamily="@font/arita_semibold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_premium_letter_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="한 번 구매하면 계속 사용할 수 있어요"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        android:fontFamily="@font/arita_medium"
        android:letterSpacing="-0.01"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_premium_letter_title"
        app:layout_constraintStart_toStartOf="@id/tv_premium_letter_title"
        app:layout_constraintEnd_toEndOf="@id/tv_premium_letter_title"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_premium_letter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/Circle"
        app:layout_constraintTop_toBottomOf="@id/tv_premium_letter_description"
        app:layout_constraintStart_toStartOf="@id/tv_premium_letter_description"
        app:layout_constraintEnd_toEndOf="@id/tv_premium_letter_description">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:paddingStart="12.5dp"
            android:paddingEnd="16.5dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ink_icon"/>
            <TextView
                android:id="@+id/tv_premium_letter_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="500"
                android:textColor="@color/neutral"
                android:textSize="12sp"
                android:fontFamily="@font/arita_semibold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_premium_letter_color"
        android:layout_width="268dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        tools:cardBackgroundColor="@color/letter_bg_pink"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cv_premium_letter"
        app:layout_constraintStart_toStartOf="@id/cv_premium_letter"
        app:layout_constraintEnd_toEndOf="@id/cv_premium_letter">
        <ImageView
            android:id="@+id/iv_premium_letter_banner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            tools:src="@drawable/img_letter_pink"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_premium_letter_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/neutral_weak"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="42dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/cv_premium_letter_color"
        app:layout_constraintStart_toStartOf="@id/cv_premium_letter_color"
        app:layout_constraintEnd_toStartOf="@id/btn_premium_letter_buy"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_premium_letter_buy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/brand"
        android:text="구매하기"
        android:textColor="@color/layer_white"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:layout_marginStart="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toTopOf="@id/btn_premium_letter_back"
        app:layout_constraintStart_toEndOf="@id/btn_premium_letter_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_premium_letter_back"
        app:layout_constraintEnd_toEndOf="@id/cv_premium_letter_color"/>



</androidx.constraintlayout.widget.ConstraintLayout>