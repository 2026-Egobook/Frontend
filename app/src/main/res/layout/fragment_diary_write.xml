<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.diary.DiaryWriteFragment"
    android:background="@color/white">

    <!-- 가이드라인 : 왼쪽에서 15.65dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="15.65dp" />

    <!-- 가이드라인 : 오른쪽에서 16.35dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16.35dp"/>

    <!--날짜 출력 레이아웃 -->
    <LinearLayout
        android:id="@+id/date_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_left"
            android:contentDescription="back to DiartFragment"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tv_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025년 12월 25일"
            android:textSize="20sp"
            android:fontFamily="@font/arita_semibold"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>

    <!--안내 문구: 가이드라인에 맞춤 -->
    <LinearLayout
        android:id="@+id/guide_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/date_layout"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        android:layout_marginEnd="16.35dp"
        android:gravity="start"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_what"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="어떤 일기를 작성할까요?"
            android:textSize="16sp"
            android:fontFamily="@font/arita_semibold"/>

        <TextView
            android:id="@+id/tv_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="여러개를 선택할 수 있어요"
            android:fontFamily="@font/arita_medium"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!--일기 유형 선택: 가이드라인에 맞춰 양끝 정렬 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/type_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/guide_layout"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_end">

        <TextView
            android:id="@+id/tv_emotion"
            android:layout_width="73dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="감정"
            android:textColor="@color/dark_bage_text"
            android:fontFamily="@font/arita_semibold"
            android:background="@drawable/bg_tag_emotion"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_worry"
            app:layout_constraintHorizontal_chainStyle="spread_inside" />

        <TextView
            android:id="@+id/tv_worry"
            android:layout_width="73dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="고민"
            android:textColor="@color/cos_black"
            android:fontFamily="@font/arita_semibold"
            android:background="@drawable/bg_tag_emotion_default"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_emotion"
            app:layout_constraintEnd_toStartOf="@+id/tv_praise" />

        <TextView
            android:id="@+id/tv_praise"
            android:layout_width="73dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="칭찬"
            android:textColor="@color/cos_black"
            android:fontFamily="@font/arita_semibold"
            android:background="@drawable/bg_tag_emotion_default"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_worry"
            app:layout_constraintEnd_toStartOf="@+id/tv_thanks" />

        <TextView
            android:id="@+id/tv_thanks"
            android:layout_width="73dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="감사"
            android:textColor="@color/cos_black"
            android:fontFamily="@font/arita_semibold"
            android:background="@drawable/bg_tag_emotion_default"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_praise"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--지금 기분은 어떤가요    -->
    <TextView
        android:id="@+id/tv_how_is_your_feeling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/type_layout"
        android:layout_marginTop="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="start"
        android:text="지금 기분은 어떤가요?"
        android:textSize="16sp"
        android:textColor="@color/cos_black"
        android:fontFamily="@font/arita_semibold"/>

<!--    <LinearLayout-->
<!--        android:id="@+id/state_layout"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        />-->

</androidx.constraintlayout.widget.ConstraintLayout>