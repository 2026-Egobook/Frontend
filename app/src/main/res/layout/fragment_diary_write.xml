<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sv_diary_write"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".ui.diary.view.DiaryWriteFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="22dp">

            <!-- 💡 상단 날짜 레이아웃을 스크롤뷰 안으로 이동 -->
            <LinearLayout
                android:id="@+id/date_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:background="@color/white">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_left"
                    app:iconTint="@color/cos_black"
                    app:iconSize="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="back to DiaryFragment"/>

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025년 12월 25일"
                    android:textSize="20sp"
                    android:fontFamily="@font/arita_semibold"
                    android:textColor="@color/cos_black"/>
            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/inner_guideline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="16dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/inner_guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="16dp"/>

            <!-- 안내 문구 (상단 날짜 레이아웃 아래로 제약조건 변경) -->
            <LinearLayout
                android:id="@+id/guide_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/date_layout"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/inner_guideline_end"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_what"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="어떤 일기를 작성할까요?"
                    android:textSize="16sp"
                    android:fontFamily="@font/arita_semibold"
                    android:textColor="@color/cos_black"/>

                <TextView
                    android:id="@+id/tv_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여러개를 선택할 수 있어요"
                    android:fontFamily="@font/arita_medium"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- 일기 유형 선택 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/type_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/guide_layout"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/inner_guideline_end">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_emotion"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/selector_weekly_report_style_bg"
                    app:strokeColor="@color/selector_weekly_report_style_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="99dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cv_worry"
                    app:layout_constraintHorizontal_chainStyle="spread_inside">
                    <TextView
                        android:id="@+id/tv_emotion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="감정"
                        android:textColor="@color/selector_diary_write_style_text"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_worry"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/selector_weekly_report_style_bg"
                    app:strokeColor="@color/selector_weekly_report_style_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="99dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cv_emotion"
                    app:layout_constraintEnd_toStartOf="@id/cv_praise"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/tv_worry"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="고민"
                        android:textColor="@color/selector_diary_write_style_text"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_praise"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/selector_weekly_report_style_bg"
                    app:strokeColor="@color/selector_weekly_report_style_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="99dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cv_worry"
                    app:layout_constraintEnd_toStartOf="@id/cv_thanks"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/tv_praise"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="칭찬"
                        android:textColor="@color/selector_diary_write_style_text"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_thanks"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/selector_weekly_report_style_bg"
                    app:strokeColor="@color/selector_weekly_report_style_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="99dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cv_praise"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/tv_thanks"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="감사"
                        android:textColor="@color/selector_diary_write_style_text"/>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 질문 문구 -->
            <TextView
                android:id="@+id/tv_how_is_your_feeling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintTop_toBottomOf="@id/type_layout"
                android:layout_marginTop="24dp"
                android:text="지금 기분은 어떤가요?"
                android:textSize="16sp"
                android:textColor="@color/cos_black"
                android:fontFamily="@font/arita_semibold"/>

            <!-- 상태 지표 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/state_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/inner_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/tv_how_is_your_feeling"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_bad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="매우 좋지 않음\n(1)"
                    android:textColor="@color/grey"
                    android:textSize="12sp"
                    android:fontFamily="@font/arita_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_good"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="매우 좋음\n(5)"
                    android:textColor="@color/grey"
                    android:textSize="12sp"
                    android:fontFamily="@font/arita_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 감정 이미지들 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/emotion_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/inner_guideline_end"
                app:layout_constraintTop_toBottomOf="@id/state_layout"
                android:layout_marginTop="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_emotion1"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/img_emotion_very_sad"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_emotion2"
                    app:layout_constraintHorizontal_chainStyle="spread_inside" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_emotion2"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/img_emotion_sad"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_emotion1"
                    app:layout_constraintEnd_toStartOf="@+id/iv_emotion3" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_emotion3"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/img_emotion_neutral"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_emotion2"
                    app:layout_constraintEnd_toStartOf="@+id/iv_emotion4" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_emotion4"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/img_emotion_happy"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_emotion3"
                    app:layout_constraintEnd_toStartOf="@+id/iv_emotion5" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_emotion5"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/img_emotion_very_happy"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_emotion4"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 일기 입력 박스 -->
            <LinearLayout
                android:id="@+id/input_box_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_diary_input"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/emotion_layout"
                app:layout_constraintStart_toStartOf="@id/inner_guideline_start"
                app:layout_constraintEnd_toEndOf="@id/inner_guideline_end">

                <TextView
                    android:id="@+id/tv_input_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025.12.25 17:32"
                    android:textSize="12sp"
                    android:textColor="@color/cos_grey"
                    android:fontFamily="@font/arita_medium" />

                <EditText
                    android:id="@+id/et_diary_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="오늘 하루는 어땠나요?"
                    android:minLines="10"
                    android:lineSpacingExtra="5dp"
                    android:fontFamily="@font/arita_medium"
                    android:textSize="14sp"
                    android:textColor="@color/cos_black"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine" />

                <TextView
                    android:id="@+id/tv_char_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="0/400"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/arita_medium" />
            </LinearLayout>

        <!-- 유연한 공간 (입력칸과 버튼 사이) -->
        <Space
            android:id="@+id/space_flexible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/input_box_layout"
            app:layout_constraintBottom_toTopOf="@id/btn_save"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- 저장하기 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/SaveButtonStyle"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="저장하기"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <ProgressBar
            android:id="@+id/pb_loading"
            style="@style/LoadingProgressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
