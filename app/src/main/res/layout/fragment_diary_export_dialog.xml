<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    tools:context=".ui.diary.view.DiaryExportDialogFragment"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="40dp"
        android:background="@drawable/dialog_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_export_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_bold"
            android:text="일기 내보내기"
            android:textColor="@color/cos_black"
            android:textSize="16sp" />

        <!-- 시작 날짜 입력 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_date_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/icStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_calendar" />
            
            <EditText
                android:id="@+id/tv_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="YYYY.MM.DD"
                android:textColorHint="@color/grey"
                android:inputType="number"
                android:digits="0123456789."
                android:maxLength="10"
                android:layout_marginStart="10dp"/>


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:text="~"
            android:textColor="@color/neutral"
            android:textSize="16sp"
            android:fontFamily="@font/arita_semibold"/>

        <!-- 종료 날짜 입력 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_date_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/icEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_calendar" />

            <EditText
                android:id="@+id/tv_last_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="YYYY.MM.DD"
                android:textColorHint="@color/grey"
                android:layout_marginStart="10dp"
                android:inputType="number"
                android:digits="0123456789."
                android:maxLength="10"/>


        </LinearLayout>

        <TextView
            android:id="@+id/tv_export_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/arita_medium"
            android:text="최대 1년 단위로 내보낼 수 있어요"
            android:textColor="@color/neutral_subtle"
            android:textSize="12sp"
            android:gravity="center"/>

        <!-- 하단 버튼 그룹 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pdf"
                style="@style/SaveButtonStyle"
                android:layout_width="94.5dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="PDF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_text"
                style="@style/SaveButtonStyle"
                android:layout_width="94.5dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="TEXT" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
