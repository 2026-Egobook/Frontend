<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="24dp"
    android:background="@drawable/dialog_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_square_report_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="해당 글을 신고하시겠어요?"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_square_report_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="허위 신고일 경우 제제를 받을 수 있어요"
        android:textColor="@color/cos_red"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_title"
        app:layout_constraintStart_toStartOf="@id/tv_square_report_title"
        app:layout_constraintEnd_toEndOf="@id/tv_square_report_title"/>

    <TextView
        android:id="@+id/tv_square_report_content_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비속어 또는 모욕적인 표현이 있어요"
        android:layout_marginTop="16dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/view_square_report_content_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_content_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_square_report_content_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="광고 또는 스팸 글이에요"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_content_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/view_square_report_content_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_content_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_square_report_content_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="부적절한 내용을 담고 있어요"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_content_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/view_square_report_content_3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_content_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_square_report_content_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="기타 (직접 작성)"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_content_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/view_square_report_content_4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_content_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_square_report_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        android:backgroundTint="@color/grey_light"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_content_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_square_report_report" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_square_report_report"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="@color/cos_red_dark"
        android:text="신고하기"
        android:textColor="@color/layer_white"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toTopOf="@id/btn_square_report_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_square_report_back"
        app:layout_constraintStart_toEndOf="@id/btn_square_report_back"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>