<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="24dp">

    <TextView
        android:id="@+id/tv_square_report_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="해당 글을 신고하시겠어요?"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_square_report_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="허위 신고일 경우 제제를 받을 수 있어요"
        android:textColor="@color/cos_red"
        app:layout_constraintEnd_toEndOf="@id/tv_square_report_title"
        app:layout_constraintStart_toStartOf="@id/tv_square_report_title"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_title" />

    <TextView
        android:id="@+id/tv_square_report_abuse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:background="@color/selector_square_report_textview_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="비속어 또는 모욕적인 표현이 있어요"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_description" />

    <View
        android:id="@+id/view_square_report_divider_abuse"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_abuse" />

    <TextView
        android:id="@+id/tv_square_report_spam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/selector_square_report_textview_bg"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="광고 또는 스팸 글이에요"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_divider_abuse" />

    <View
        android:id="@+id/view_square_report_divider_spam"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_spam" />

    <TextView
        android:id="@+id/tv_square_report_inappropriate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/selector_square_report_textview_bg"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="부적절한 내용을 담고 있어요"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_divider_spam" />

    <View
        android:id="@+id/view_square_report_divider_inappropriate"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_square_report_inappropriate" />

    <FrameLayout
        android:id="@+id/fl_square_report_etc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_divider_inappropriate">
        <TextView
            android:id="@+id/tv_square_report_etc_not_clicked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="기타 (직접 작성)" />
        <LinearLayout
            android:id="@+id/ll_square_report_etc_clicked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/green_secondary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타(직접 작성)"/>
            <EditText
                android:id="@+id/et_square_report_etc_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:gravity="start"
                android:background="@drawable/bg_white_and_radius"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="6dp"
                android:hint="신고 사유를 작성해주세요"/>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/view_square_report_divider_etc"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/neutral_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_square_report_etc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_square_report_back"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/grey_light"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        app:cornerRadius="4dp"
        app:layout_constraintEnd_toStartOf="@id/btn_square_report_submit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_square_report_divider_etc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_square_report_submit"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/selector_square_button_text"
        android:backgroundTint="@color/selector_square_report_button_bg"
        android:enabled="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="신고하기"
        app:cornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_square_report_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_square_report_back"
        app:layout_constraintTop_toTopOf="@id/btn_square_report_back" />

</androidx.constraintlayout.widget.ConstraintLayout>