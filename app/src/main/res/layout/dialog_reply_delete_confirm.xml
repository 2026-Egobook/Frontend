<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_round_and_white_dialog">

    <TextView
        android:id="@+id/tv_reply_delete_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나의 답변을\n삭제하시겠어요?"
        android:textColor="@color/neutral"
        android:textSize="16sp"
        android:fontFamily="@font/arita_semibold"
        android:lineHeight="21sp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_reply_delete_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arita_medium"
        android:letterSpacing="-0.01"
        android:layout_marginTop="16dp"
        android:text="삭제한 답변은 복구할 수 없어요"
        android:textColor="@color/critical"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_reply_delete_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reply_delete_cancel"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/grey_light"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reply_delete_warning"
        app:layout_constraintEnd_toStartOf="@id/btn_reply_delete_confirm"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reply_delete_confirm"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/cos_red_dark"
        android:text="삭제하기"
        android:textColor="@color/layer_white"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_reply_delete_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_reply_delete_cancel"
        app:layout_constraintTop_toTopOf="@+id/btn_reply_delete_cancel" />

</androidx.constraintlayout.widget.ConstraintLayout>



