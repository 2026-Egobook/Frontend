<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:gravity="center">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background"
        android:minWidth="327dp"
        android:paddingBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="vertical" >
        
        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_psychology_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2025.12.25"
                android:textColor="@color/grey"
                android:layout_gravity="center"
                android:fontFamily="@font/arita_medium"
                android:textSize="12dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bookmark_unclicked" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_psychology_content"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            tools:text="오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 "
            android:textSize="16dp"
            android:textColor="@color/neutral"
            android:fontFamily="@font/arita_semibold" />

        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_psychology_source"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_medium"
            android:textColor="@color/grey"
            android:textSize="12dp"
            tools:text="Strack, Martin,  Stepper, 1988, Journal of Personality and Social Psychology"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/brand_radius_border_dialog_button"
            android:textColor="@color/neutral_contrast"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:fontFamily="@font/arita_semibold"
            android:textSize="12dp"
            android:textAlignment="center"
            android:text="잉크 획득" />


    </LinearLayout>

</FrameLayout>
