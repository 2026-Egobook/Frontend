<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_add_friend_search_result_found"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_add_friend_search_image"
        android:layout_width="145dp"
        android:layout_height="0dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_add_friend_search_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/default_turtle" />
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/iv_add_friend_search_level"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/level_type_1"
        app:layout_constraintBottom_toTopOf="@id/tv_add_friend_search_nickname"
        app:layout_constraintStart_toEndOf="@id/cv_add_friend_search_image"
        app:layout_constraintTop_toTopOf="@id/cv_add_friend_search_image" />

    <TextView
        android:id="@+id/tv_add_friend_search_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arita_semibold"
        tools:text="LV 9999"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_add_friend_search_level"
        app:layout_constraintStart_toEndOf="@id/iv_add_friend_search_level"
        app:layout_constraintTop_toTopOf="@id/iv_add_friend_search_level" />

    <TextView
        android:id="@+id/tv_add_friend_search_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/arita_semibold"
        tools:text="친구 이름"
        android:textColor="@color/neutral"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn_add_friend_search_result_apply"
        app:layout_constraintStart_toStartOf="@id/iv_add_friend_search_level"
        app:layout_constraintTop_toBottomOf="@id/iv_add_friend_search_level" />

    <ImageView
        android:id="@+id/iv_item_friend_pending_sent_list_symbol"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_square_friend_answer_star"
        app:layout_constraintBottom_toBottomOf="@id/tv_add_friend_search_nickname"
        app:layout_constraintStart_toEndOf="@id/tv_add_friend_search_nickname"
        app:layout_constraintTop_toTopOf="@id/tv_add_friend_search_nickname" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_friend_search_result_apply"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/neutral"
        android:fontFamily="@font/arita_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="신청하기"
        android:textColor="@color/layer_white"
        android:textSize="12sp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@id/cv_add_friend_search_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_add_friend_search_nickname"
        app:layout_constraintTop_toBottomOf="@id/tv_add_friend_search_nickname" />

</androidx.constraintlayout.widget.ConstraintLayout>