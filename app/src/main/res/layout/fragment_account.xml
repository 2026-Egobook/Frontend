<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.account.view.AccountFragment">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:background="#F4F7EE"
            android:paddingBottom="21dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/frameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

        <!--통용 가이드라인-->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gd_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="16dp"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gd_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="16dp"/>

        <!--맨 위 메뉴바-->
        <LinearLayout
            android:id="@+id/ly_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_left"
                app:iconTint="@color/cos_black"
                app:iconSize="24dp"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:text="계정"
                android:textSize="20sp"
                android:fontFamily="@font/arita_semibold"
                android:gravity="center_vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_integrate"
                style="@style/IntegrateButtonStyle"
                android:layout_width="92dp"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconTint="@null"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                android:text="연동하기"
                android:gravity="center"
                android:layout_marginEnd="16dp"/>

        </LinearLayout>

        <!-- 계정id -->
        <LinearLayout
            android:id="@+id/ly_account_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_account_id"
            app:layout_constraintTop_toBottomOf="@id/ly_top"
            app:layout_constraintStart_toStartOf="@id/gd_start"
            app:layout_constraintEnd_toEndOf="@id/gd_end">

            <TextView
                android:id="@+id/tv_account_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="계정 ID"
                android:textSize="14sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_semibold" />

            <android.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            
            <TextView
                android:id="@+id/tv_real_account_id"
                android:layout_width="229dp"
                android:layout_height="24dp"
                android:text="ABC123456789"
                android:textSize="16sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_semibold"
                android:gravity="center" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_introduce_features"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/ly_account_id"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="@id/gd_start"
            app:layout_constraintEnd_toEndOf="@id/gd_end"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_introduce_features">
            
            <TextView
                android:id="@+id/tv_introduce_feature"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:text="특별 기능 소개"
                android:textColor="@color/neutral"
                android:textSize="20sp"
                android:fontFamily="@font/arita_semibold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/ly_feature_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_introduce_feature"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="에고룸 주간 리포트 제공"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="에고북이 제공하는 레포트를 받아볼 수 있어요\n광고를 보거나 잉크를 지불하여 확인할 수 있어요"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_weekly_report"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_feature_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ly_feature_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="에고룸 통계 제공"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="광고를 시청하면 수시로 에고북이 제공하는 레포트를\n받아볼 수 있어요"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_statistics"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_feature_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ly_feature_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상점 아이템 이용"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="잉크를 지불하면 아이템을 구매할 수 있어요\n나만의 고북이를 꾸며보세요"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_customizing"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_feature_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ly_feature_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="편지지 색상 변경"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="특별한 편지지를 사용하여 편지를 작성할 수 있어요.\n원하는 색상으로 자유롭게 표현해 보세요\n잉크를 지불하여 구매할 수 있습니다"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:id="@+id/iv_introduce"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_letter"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_feature_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ly_feature_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일일 미션 클리어 시 잉크 제공"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="일일 미션을 달성할 때마다 1 잉크를 얻을 수 있어요.\n7일 완료하면 추가 2 잉크도 얻을 수 있어요. 꾸준히\n활동하는 습관을 만들 때 큰 도움이 될 거예요"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_daily"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_feature_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ly_feature_5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="매일 3 잉크 제공"
                    android:textSize="16sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_semibold"/>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="접속하기만 해도 자동으로 3 잉크를 받을 수\n있어요"
                    android:textSize="14sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/img_benefit_daily_ink"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <LinearLayout
            android:id="@+id/ly_bottom_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/ly_introduce_features"
            app:layout_constraintStart_toStartOf="@id/gd_start"
            app:layout_constraintEnd_toEndOf="@id/gd_end">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="고객지원"
                android:textSize="14sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_semibold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="회원 탈퇴"
                android:textSize="14sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_semibold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="10dp"
                android:gravity="center"
                android:text="이용약관 및 개인정보처리"
                android:textSize="14sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_semibold"/>


        </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- 블러 오버레이 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>

