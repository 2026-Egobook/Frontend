<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.onboarding.view.OnboardingFragment2">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gd_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="64dp"/>

    <TextView
        android:id="@+id/tv_onboarding_2_1"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        app:layout_constraintTop_toTopOf="@id/gd_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_onboarding_2_2"
        android:text="감정 일기 작성"
        android:textSize="20sp"
        android:textColor="@color/brand_grass"
        android:fontFamily="@font/arita_semibold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tv_onboarding_2_2"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="4dp"
        android:text="나의 감정을 들여다보는 시간을 가져요"
        android:textSize="14sp"
        android:textColor="@color/cos_black"
        android:fontFamily="@font/arita_medium"
        android:lineHeight="21sp"
        app:layout_constraintTop_toBottomOf="@id/tv_onboarding_2_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="279dp"
        android:layout_height="388dp"
        android:padding="10dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/bg_onboarding_image_container2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_no_bottom"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:padding="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_onboarding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_onboarding_2"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.OnboardingCard"
                android:layout_marginBottom="12dp"/>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>