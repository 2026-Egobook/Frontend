<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="24dp"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_round_and_white_dialog">

    <TextView
        android:id="@+id/tv_letter_delete_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나의 편지를\n삭제하시겠어요?"
        android:textColor="@color/neutral"
        android:textSize="16sp"
        android:fontFamily="@font/arita_semibold"
        android:lineHeight="21sp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_letter_delete_character"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:shapeAppearanceOverlay="@style/Circle"
        app:cardBackgroundColor="@color/green_secondary"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_letter_delete_title"
        app:layout_constraintStart_toStartOf="@id/tv_letter_delete_title"
        app:layout_constraintEnd_toEndOf="@id/tv_letter_delete_title">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_detect_words_loading"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_letter_delete_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="삭제한 편지는 복구할 수 없어요"
        android:textColor="@color/critical"
        android:textSize="12sp"
        android:fontFamily="@font/arita_medium"
        android:letterSpacing="-0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv_letter_delete_character" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_letter_delete_ink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/Circle"
        app:layout_constraintTop_toBottomOf="@id/tv_letter_delete_warning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:paddingStart="12.5dp"
            android:paddingEnd="16.5dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ink_icon"/>
            <TextView
                android:id="@+id/tv_letter_delete_ink_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="999"
                android:textColor="@color/neutral"
                android:textSize="12sp"
                android:fontFamily="@font/arita_semibold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_letter_delete_cancel"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/grey_light"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_letter_delete_ink"
        app:layout_constraintEnd_toStartOf="@id/btn_letter_delete_confirm"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_letter_delete_confirm"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:backgroundTint="@color/cos_red_dark"
        android:text="삭제하기"
        android:textColor="@color/layer_white"
        android:textSize="12sp"
        android:fontFamily="@font/arita_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_letter_delete_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_letter_delete_cancel"
        app:layout_constraintTop_toTopOf="@+id/btn_letter_delete_cancel" />

</androidx.constraintlayout.widget.ConstraintLayout>