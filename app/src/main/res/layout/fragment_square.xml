<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/ll_square_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="9dp"
                android:layout_weight="1"
                android:text="광장" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_square_navigate_to_friends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="7dp"
                android:backgroundTint="@android:color/transparent"
                android:text="친구"
                android:textColor="@color/black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="24dp"
                app:cornerRadius="4dp"
                app:strokeColor="@color/neutral_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_square_letter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="편지"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_square_header" />

        <HorizontalScrollView
            android:id="@+id/hsv_square_letter_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_square_letter_title"
            app:layout_constraintTop_toBottomOf="@id/tv_square_letter_title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@drawable/divider_width_12dp"
                android:showDividers="middle"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/neutral_stroke">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14.5dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_letter_new" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="편지쓰기" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1/1" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/neutral_stroke">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14.5dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_letter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="짱구" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3시간 남음"
                            android:textColor="@color/neutral_subtle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/neutral_stroke">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14.5dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_letter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="흰둥이" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5시간 남음"
                            android:textColor="@color/neutral_subtle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/neutral_stroke">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14.5dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_letter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="짱아" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6시간 남음"
                            android:textColor="@color/neutral_subtle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="@color/neutral_stroke">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14.5dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_letter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="맹구" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7시간 남음"
                            android:textColor="@color/neutral_subtle" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/ll_square_letter_mine_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="6.5dp"
            app:layout_constraintStart_toStartOf="@id/hsv_square_letter_box"
            app:layout_constraintTop_toBottomOf="@id/hsv_square_letter_box"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/tv_square_letter_mine_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="내가 쓴 편지" />

            <TextView
                android:id="@+id/tv_square_my_letters_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="전체 보기"
                android:textColor="@color/neutral_subtle" />

            <ImageView
                android:id="@+id/iv_square_letter_mine_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_square_view_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_square_letter_mine_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:divider="@drawable/divider_height_8dp"
            android:showDividers="middle"
            app:layout_constraintTop_toBottomOf="@id/ll_square_letter_mine_header"
            app:layout_constraintStart_toStartOf="@id/ll_square_letter_mine_header"
            app:layout_constraintEnd_toEndOf="@id/ll_square_letter_mine_header">
            <include
                layout="@layout/item_square_letter" />
            <include
                layout="@layout/item_square_letter" />
            <include
                layout="@layout/item_square_letter" />
            <include
                layout="@layout/item_square_letter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_square_today_question_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:paddingVertical="6.5dp"
            app:layout_constraintStart_toStartOf="@id/ll_square_letter_mine_box"
            app:layout_constraintTop_toBottomOf="@id/ll_square_letter_mine_box"
            app:layout_constraintEnd_toEndOf="@id/ll_square_letter_mine_box">
            <TextView
                android:id="@+id/tv_square_today_question_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="오늘의 질문" />

            <TextView
                android:id="@+id/tv_square_today_question_my_replies_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="나의 답변 기록"
                android:textColor="@color/neutral_subtle" />

            <ImageView
                android:id="@+id/iv_square_today_question_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_square_view_all" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_square_today_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/ll_square_today_question_header"
            app:layout_constraintStart_toStartOf="@id/ll_square_today_question_header"
            app:layout_constraintEnd_toEndOf="@id/ll_square_today_question_header">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_square_today_question">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_square_question_turtle"
                    android:layout_marginEnd="-152dp"
                    android:layout_marginBottom="-12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_square_question_turtle"
                    android:rotationY="180"
                    android:layout_marginStart="-132dp"
                    android:layout_marginBottom="-12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_square_today_question_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Q. 다시 태어난다면 어느 나라에서 태어나고 싶으신가요?"
                    android:textAlignment="center"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="24dp"
                    android:translationZ="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_square_today_question_description_answered"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:translationZ="10dp"
                    android:layout_marginVertical="24dp"
                    android:layout_marginHorizontal="12dp"
                    app:contentPadding="16dp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/yellow_subtle"
                    app:layout_constraintTop_toBottomOf="@id/tv_square_today_question_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:id="@+id/tv_square_today_question_description_answered"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textAlignment="center"
                        android:text="사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답 사용자가 작성한 답"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/tv_square_today_question_description_unanswered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아직 오늘의 질문에\n답을 하지 않았어요"
                    android:textAlignment="center"
                    android:layout_marginTop="24dp"
                    tools:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/tv_square_today_question_content"
                    app:layout_constraintStart_toStartOf="@id/tv_square_today_question_content"
                    app:layout_constraintEnd_toEndOf="@id/tv_square_today_question_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_square_today_question_write"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="작성하기"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/neutral"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    tools:visibility="gone"
                    app:cornerRadius="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_square_today_question_description_unanswered"
                    app:layout_constraintStart_toStartOf="@id/tv_square_today_question_description_unanswered"
                    app:layout_constraintEnd_toEndOf="@id/tv_square_today_question_description_unanswered"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/ll_square_friends_answer_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:paddingVertical="6.5dp"
            app:layout_constraintStart_toStartOf="@id/cv_square_today_question"
            app:layout_constraintTop_toBottomOf="@id/cv_square_today_question"
            app:layout_constraintEnd_toEndOf="@id/cv_square_today_question">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="친구의 답변" />

            <TextView
                android:id="@+id/tv_square_all_users_replies_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="전체 유저 답변"
                android:textColor="@color/neutral_subtle" />

            <ImageView
                android:id="@+id/iv_square_friends_answer_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_square_view_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_square_friends_answer_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ll_square_friends_answer_header"
            app:layout_constraintStart_toStartOf="@id/ll_square_friends_answer_header"
            app:layout_constraintEnd_toEndOf="@id/ll_square_friends_answer_header">
            <include
                layout="@layout/item_square_friend_answer"/>
            <include
                layout="@layout/item_square_friend_answer"/>
            <include
                layout="@layout/item_square_friend_answer"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>