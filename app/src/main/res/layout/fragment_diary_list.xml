<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.diary.view.DiaryListFragment"
    android:paddingHorizontal="17dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_diary"
        tools:listitem="@layout/item_diary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- ⭐ empty view -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_gravity="center">

        <TextView
            android:id="@+id/tv_empty_title"
            android:text="작성된 일기가 없어요"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:textSize="20sp"
            android:textColor="@color/cos_black"
            android:fontFamily="@font/arita_bold"
            android:gravity="center"/>

        <TextView
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="오늘의 일기를 작성해 보세요"
            android:textSize="14sp"
            android:textColor="@color/cos_black"
            android:fontFamily="@font/arita_medium"
            android:gravity="center"/>
    </LinearLayout>

</FrameLayout>