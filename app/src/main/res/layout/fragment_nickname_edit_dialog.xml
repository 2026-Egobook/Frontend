<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임 수정"
            android:textSize="22sp"
            android:textColor="@color/neutral"
            android:fontFamily="@font/arita_semibold"
            android:gravity="center"/>

        <TextView
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최대 8자까지 작성할 수 있습니다"
            android:textSize="14sp"
            android:textColor="@color/neutral_subtle"
            android:fontFamily="@font/arita_medium"
            android:gravity="center"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/neutral_stroke"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:hint="기존 닉네임"
                android:textSize="17sp"
                android:textColor="@color/neutral"
                android:fontFamily="@font/arita_medium"
                android:maxLength="8"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center_vertical"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="68dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="10dp"
                android:text="돌아가기"
                android:textSize="16sp"
                android:textColor="@color/cos_black"
                android:fontFamily="@font/arita_semibold"
                android:letterSpacing="-0.03"
                android:textAllCaps="false"
                app:backgroundTint="@color/neutral_weak"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                style="@style/GreenButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="68dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="수정하기"
                android:textSize="16sp"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
