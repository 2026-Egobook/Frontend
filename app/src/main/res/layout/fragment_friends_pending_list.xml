<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layer_white"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.square.view.FriendsPendingListFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_friends_pending_list_received_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나에게 온 신청"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_friends_pending_list_received_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="3"
            app:layout_constraintBottom_toBottomOf="@id/tv_friends_pending_list_received_title"
            app:layout_constraintStart_toEndOf="@id/tv_friends_pending_list_received_title"
            app:layout_constraintTop_toTopOf="@id/tv_friends_pending_list_received_title" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_friends_pending_list_received"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_friends_pending_list_received_title">
        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            android:id="@+id/tv_friends_pending_list_sent_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내가 한 신청"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ll_friends_pending_list_received"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_friends_pending_list_sent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tv_friends_pending_list_sent_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>