<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_item_letter"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:layout_marginTop="12.5dp"
        android:src="@drawable/ic_letter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_item_square_letter_datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2025.08.27"
        android:textSize="14sp"
        android:fontFamily="@font/arita_medium"
        android:letterSpacing="-0.02"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/iv_item_letter"
        app:layout_constraintStart_toEndOf="@id/iv_item_letter"
        app:layout_constraintBottom_toBottomOf="@id/iv_item_letter"/>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12.5dp"
        android:background="@color/green_secondary"
        app:layout_constraintTop_toBottomOf="@id/iv_item_letter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>