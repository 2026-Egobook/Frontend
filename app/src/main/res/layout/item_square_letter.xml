<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/layer_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_item_letter"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_letter"/>

    <TextView
        android:id="@+id/tv_item_square_letter_datetime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="21sp"
        android:gravity="center_vertical"
        tools:text="2025.08.27"
        android:textColor="@color/neutral"
        android:textSize="14sp"
        android:fontFamily="@font/arita_medium"
        android:letterSpacing="-0.02"
        android:layout_marginStart="8dp"/>

</LinearLayout>