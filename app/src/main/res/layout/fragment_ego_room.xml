<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.counseling.view.EgoRoomFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_counseling_main_top_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_counseling_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_semibold"
            android:text="에고룸"
            android:textColor="@color/neutral"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_counseling_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:fontFamily="@font/arita_medium"
            android:text="나를 돌보는 시간, 에고북의 위로와 조언"
            android:textColor="@color/neutral"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv_counseling_main_title"
            app:layout_constraintTop_toBottomOf="@id/tv_counseling_main_title" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tl_counseling"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_counseling_sub_title"
            app:tabIndicatorColor="@color/brand"
            app:tabIndicatorFullWidth="true"
            app:tabSelectedTextColor="@color/neutral"
            app:tabTextAppearance="@style/CounselingTabTextAppearance"
            app:tabTextColor="@color/neutral_subtle">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="일간 칭찬서" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="주간 리포트" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="통계" />
        </com.google.android.material.tabs.TabLayout>

        <View
            android:id="@+id/view_tab_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/neutral_stroke"
            app:layout_constraintBottom_toBottomOf="@id/tl_counseling"
            app:layout_constraintEnd_toEndOf="@id/tl_counseling"
            app:layout_constraintStart_toStartOf="@id/tl_counseling" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_counseling"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_counseling_main_top_container" />

</androidx.constraintlayout.widget.ConstraintLayout>