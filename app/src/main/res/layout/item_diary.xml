<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17:00"
        android:textColor="@color/cos_black"
        android:fontFamily="@font/arita_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="12sp"/>

    <!--감정 이미지가 들어갈 자리    -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_emotion"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:srcCompat="@drawable/img_emotion"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Circle"
        app:layout_constraintStart_toStartOf="@id/tv_time"
        app:layout_constraintTop_toBottomOf="@id/tv_time"
        android:layout_marginTop="10dp"/>
    
    <LinearLayout
        android:id="@+id/emotion_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_time"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tv_emotion"
            android:layout_width="46dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="감정"
            android:textColor="@color/dark_bage_text"
            android:includeFontPadding="false"
            android:background="@drawable/bg_tag_emotion"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tv_worry"
            android:layout_width="46dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="고민"
            android:textColor="@color/dark_bage_text"
            android:includeFontPadding="false"
            android:background="@drawable/bg_tag_emotion"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tv_praise"
            android:layout_width="46dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="칭찬"
            android:textColor="@color/dark_bage_text"
            android:includeFontPadding="false"
            android:background="@drawable/bg_tag_emotion"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tv_thanks"
            android:layout_width="46dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="감사"
            android:textColor="@color/dark_bage_text"
            android:includeFontPadding="false"
            android:background="@drawable/bg_tag_emotion"
            android:layout_marginEnd="4dp"/>
        
    </LinearLayout>

    <TextView
        android:id="@+id/tv_diary_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/emotion_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginStart="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"

        android:text="일기 내용"
        android:textColor="@color/cos_black"
        android:textSize="14sp"
        android:fontFamily="@font/arita_medium"

        android:maxLines="3"
        android:ellipsize="end"
        android:lineHeight="18sp"
        android:includeFontPadding="false"
        android:breakStrategy="high_quality"
        />

    <View
        android:id="@+id/item_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toBottomOf="@id/tv_diary_content"
        app:layout_constraintStart_toStartOf="@id/iv_emotion"
        android:layout_marginTop="16dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
