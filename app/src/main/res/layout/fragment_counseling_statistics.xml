                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <com.example.egobook_frontent.ui.counseling.view.WordBubbleView
                android:id="@+id/wbv_counseling_statistics_word_frequency"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_counseling_statistics_word_frequency_title"
                app:layout_constraintStart_toStartOf="@id/tv_counseling_statistics_word_frequency_title"
                app:layout_constraintEnd_toEndOf="@id/tv_counseling_statistics_word_frequency_title"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>