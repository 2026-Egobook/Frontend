<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layer_white"
    android:fillViewport="true"
    tools:context=".ui.square.view.LetterReplyFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/ll_letter_reply_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="답장 하기" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_letter_reply_letter_received_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_letter_reply_header">

            <TextView
                android:id="@+id/tv_letter_reply_letter_received_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="받은 편지"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_up"
                app:layout_constraintBottom_toBottomOf="@id/tv_letter_reply_letter_received_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_letter_reply_letter_received_title" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="편지원문이 보이는자리 편지원문이 보이는자리편지원문이 보이는자리편지원문이 보이는자리편지원문이 보이는자리편지원문이 보이는자리편지원문이 보이는자리편지원문이 보이는자리"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_letter_reply_letter_received_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_letter_reply_mine_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_letter_reply_letter_received_container">

            <TextView
                android:id="@+id/tv_letter_reply_mine_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="나의 답장"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_letter_reply_color_beige"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="28dp"
                android:src="@color/letter_bg_beige"
                app:layout_constraintStart_toStartOf="@id/tv_letter_reply_mine_title"
                app:layout_constraintTop_toBottomOf="@id/tv_letter_reply_mine_title" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_letter_reply_color_pink"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@color/letter_bg_pink"
                app:layout_constraintBottom_toBottomOf="@id/iv_letter_reply_color_beige"
                app:layout_constraintStart_toEndOf="@id/iv_letter_reply_color_beige"
                app:layout_constraintTop_toTopOf="@id/iv_letter_reply_color_beige" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_letter_reply_color_leaf"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@color/letter_bg_leaf"
                app:layout_constraintBottom_toBottomOf="@id/iv_letter_reply_color_pink"
                app:layout_constraintStart_toEndOf="@id/iv_letter_reply_color_pink"
                app:layout_constraintTop_toTopOf="@id/iv_letter_reply_color_pink" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_letter_reply_color_mint"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@color/letter_bg_mint"
                app:layout_constraintBottom_toBottomOf="@id/iv_letter_reply_color_leaf"
                app:layout_constraintStart_toEndOf="@id/iv_letter_reply_color_leaf"
                app:layout_constraintTop_toTopOf="@id/iv_letter_reply_color_leaf" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_letter_reply_color_lavender"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:src="@color/letter_bg_lavender"
                app:layout_constraintBottom_toBottomOf="@id/iv_letter_reply_color_mint"
                app:layout_constraintStart_toEndOf="@id/iv_letter_reply_color_mint"
                app:layout_constraintTop_toTopOf="@id/iv_letter_reply_color_mint" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/letter_bg_beige"
                app:cardCornerRadius="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_letter_reply_color_beige"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To 낯선 고북이"
                        app:layout_constraintBottom_toBottomOf="@id/iv_letter_reply_tooltip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/iv_letter_reply_tooltip" />

                    <ImageView
                        android:id="@+id/iv_letter_reply_tooltip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:src="@drawable/ic_help"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/iv_letter_reply_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="사용자가 작성하는 편지 내용 사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용\n\n

사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용\n\n

사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_letter_reply_tooltip" />

                    <TextView
                        android:id="@+id/iv_letter_reply_total_words"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="360/360"
                        android:textColor="@color/neutral_subtle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_letter_reply_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="From 또다른 고북이"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_letter_reply_total_words" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_letter_reply_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="답장 보내기"
            android:backgroundTint="@color/neutral"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="14dp"
            app:cornerRadius="4dp"
            app:layout_constraintTop_toBottomOf="@id/cl_letter_reply_mine_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>