<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/layer_white"
        tools:context=".ui.square.view.MyLetterDetailFragment">

        <LinearLayout
            android:id="@+id/ll_my_letter_detail_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_my_letter_detail_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/tv_my_letter_detail_sent_at"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="2025.12.25" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_letter_thread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="7dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="삭제하기"
                android:textColor="@color/black"
                app:cornerRadius="4dp"
                app:strokeColor="@color/neutral_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_my_letter_detail_sent_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="나의 편지"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_my_letter_detail_header" />

        <ImageView
            android:id="@+id/iv_my_letter_detail_sent_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_chevron_up"
            app:layout_constraintBottom_toBottomOf="@id/tv_my_letter_detail_sent_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_my_letter_detail_sent_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_my_letter_detail_sent_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/letter_bg_beige"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_my_letter_detail_sent_title"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_my_letter_detail_sent_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:text="사용자가 작성하는 편지 내용 사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용

사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용

사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용사용자가 작성하는 편지 내용" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/ll_my_letter_detail_replied"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_my_letter_detail_sent_content">

            <TextView
                android:id="@+id/tv_my_letter_detail_received_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="받은 답장"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_my_letter_detail_received_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/letter_bg_beige"
                app:cardCornerRadius="12dp"
                app:contentPadding="16dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_my_letter_detail_receiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To. 낯선 고북이"
                        app:layout_constraintBottom_toBottomOf="@id/iv_my_letter_detail_report"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/iv_my_letter_detail_report" />

                    <ImageView
                        android:id="@+id/iv_my_letter_detail_report"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:src="@drawable/ic_report"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_my_letter_detail_replied_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_my_letter_detail_report"
                        tools:text="편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편
지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의
 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용편지 답장의 내용내용내용" />

                    <TextView
                        android:id="@+id/tv_my_letter_detail_ai_generated_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="48시간 동안, 고북이가 편지 곁에 조용히 머물렀습니다.\n당신의 고북이가 마음을 담아 이 답장을 띄웁니다."
                        android:textColor="@color/grey_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_my_letter_detail_replied_content" />

                    <TextView
                        android:id="@+id/tv_my_letter_detail_sender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="From 또 다른 고북이"
                        android:textColor="@color/neutral"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_my_letter_detail_replied_content" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>