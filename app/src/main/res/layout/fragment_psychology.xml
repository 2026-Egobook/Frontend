<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_50">

    <ImageView
        android:id="@+id/iv_back_button"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginVertical="10dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_chevron_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:fontFamily="@font/arita_semibold"
        android:gravity="center_vertical"
        android:text="유리병"
        android:textColor="@color/neutral"
        android:textSize="20dp"
        app:layout_constraintStart_toEndOf="@id/iv_back_button"
        app:layout_constraintTop_toTopOf="@id/iv_back_button" />

    <TextView
        android:id="@+id/tv_today_psychology"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/arita_semibold"
        android:gravity="center_vertical"
        android:text="오늘의 심리지식"
        android:textColor="@color/neutral"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="@id/iv_back_button"
        app:layout_constraintTop_toBottomOf="@id/iv_back_button" />

    <LinearLayout
        android:id="@+id/ll_today_psychology"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/dialog_background"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_today_psychology">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/tv_psychology_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/arita_medium"
                android:textColor="@color/grey"
                android:textSize="12dp"
                tools:text="2025.12.25" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_bookmark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_bookmark_unclicked" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_psychology_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/arita_semibold"
            android:textAlignment="textStart"
            android:textColor="@color/neutral"
            android:textSize="16dp"
            tools:text="오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 들어가는 자리입니다 오늘의 심리지식에 관한 글이 " />

        <TextView
            android:id="@+id/tv_psychology_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/arita_medium"
            android:textAlignment="textStart"
            android:textColor="@color/grey"
            android:textSize="12dp"
            tools:text="Strack, Martin,  Stepper, 1988, Journal of Personality and Social Psychology" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_save_psychology"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/arita_semibold"
        android:gravity="center_vertical"
        android:text="저장한 심리지식"
        android:textColor="@color/neutral"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="@id/iv_back_button"
        app:layout_constraintTop_toBottomOf="@id/ll_today_psychology" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_saved_psychologies"
        app:layout_constraintTop_toBottomOf="@id/tv_save_psychology"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp" />

    <View
        android:id="@+id/v_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="9dp" />

    <ProgressBar
        android:id="@+id/pb_loading"
        style="@style/LoadingProgressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    
</androidx.constraintlayout.widget.ConstraintLayout>
