<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:gravity="center">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_background"
        android:gravity="center"
        android:minWidth="233dp"
        android:minHeight="180dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:orientation="vertical" >
        <TextView
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="광고를 시청하시겠어요?"
            android:textSize="16dp"
            android:textColor="@color/neutral"
            android:fontFamily="@font/arita_semibold" />

        <TextView
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_medium"
            android:textColor="@color/neutral"
            android:textSize="12dp"
            android:text="광고를 끝까지 시청하면" />

        <TextView
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_medium"
            android:textColor="@color/neutral"
            android:textSize="12dp"
            android:text="잉크를 받을 수 있어요"/>
        
        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:minWidth="50dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/neutral_border_circle">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ink_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:fontFamily="@font/arita_semibold"
                android:textColor="@color/neutral"
                android:layout_marginStart="4dp"
                android:text="8" />
            
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/neutral_weak_radius_border_dialog_button"
                android:textColor="@color/neutral"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:fontFamily="@font/arita_semibold"
                android:layout_marginEnd="12dp"
                android:textSize="12dp"
                android:textAlignment="center"
                android:text="돌아가기" />

            <TextView
                android:id="@+id/btn_watch"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/brand_radius_border_dialog_button"
                android:textColor="@color/neutral_contrast"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:fontFamily="@font/arita_semibold"
                android:textSize="12dp"
                android:textAlignment="center"
                android:text="광고 보기 1/5" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
