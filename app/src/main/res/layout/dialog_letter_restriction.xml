<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="233dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="24dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:id="@+id/tv_restriction_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:fontFamily="@font/arita_semibold"
        android:text="@string/letter_restriction_title"
        android:textColor="@color/neutral"
        android:textSize="16sp"
        android:lineHeight="24sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_restriction_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/arita_medium"
        android:textColor="@color/cos_red"
        android:textSize="12sp"
        android:lineHeight="18sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_restriction_until"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/arita_medium"
        android:textColor="@color/neutral"
        android:textSize="12sp"
        android:lineHeight="18sp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_restriction_confirm"
        style="@style/DeleteButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/letter_restriction_confirm" />
</LinearLayout>
