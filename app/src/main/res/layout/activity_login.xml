<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.login.view.LoginActivity">
    
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 실제 로그인 화면 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/img_login_background_ver2">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/cos_black"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                style="@style/Widget.App.Button.Outlined.White"
                android:layout_width="69dp"
                android:layout_height="34dp"
                android:text="로그인"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:letterSpacing="-0.03"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gd_turtle_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.175"/>
            
            <LinearLayout
                android:layout_width="261dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/gd_turtle_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clipToPadding="false"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/iv_turtle"
                    android:layout_width="136dp"
                    android:layout_height="85.5dp"
                    android:src="@drawable/img_turtle_login"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp"/>

                <ImageView
                    android:id="@+id/iv_app_title"
                    android:layout_width="200dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_app_title"/>
                
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>

                <TextView
                    android:id="@+id/tv_introduce_app"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:text="@string/introduce_app_comment"
                    android:textSize="14sp"
                    android:textColor="#344408"
                    android:fontFamily="@font/arita_medium"
                    android:gravity="center" />

            </LinearLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gd_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.975"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintBottom_toTopOf="@id/gd_bottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_google_login"
                    style="@style/LoginButtonStyle1"
                    android:layout_width="328dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Google 계정으로 회원가입"
                    app:icon="@drawable/ic_google_logo"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_guest_login"
                    style="@style/LoginButtonStyle1"
                    android:layout_width="328dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="게스트로 둘러보기"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:id="@+id/tv_start_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="시작 시 이용약관 및\n개인정보 수집 및 이용에 동의하게 됩니다"
                    android:textSize="12sp"
                    android:textColor="@color/neutral"
                    android:fontFamily="@font/arita_medium"
                    android:lineHeight="18sp"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </eightbitlab.com.blurview.BlurTarget>

    <!-- 블러 오버레이 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>
