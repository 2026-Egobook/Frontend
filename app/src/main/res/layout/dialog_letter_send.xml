<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="24dp"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_round_and_white_dialog">

    <TextView
        android:id="@+id/tv_letter_send_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="누군가에게\n편지를 보낼까요?"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_letter_send_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="익명으로 전달돼요"
        app:layout_constraintEnd_toEndOf="@+id/tv_letter_send_title"
        app:layout_constraintStart_toStartOf="@+id/tv_letter_send_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_letter_send_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_letter_send_back"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/grey_light"
        android:text="돌아가기"
        android:textColor="@color/neutral"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_letter_send_description"
        app:layout_constraintEnd_toStartOf="@id/btn_letter_send_apply"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_letter_send_apply"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:backgroundTint="@color/neutral"
        android:text="보내기"
        android:textColor="@color/layer_white"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_letter_send_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_letter_send_back"
        app:layout_constraintTop_toTopOf="@+id/btn_letter_send_back" />

</androidx.constraintlayout.widget.ConstraintLayout>