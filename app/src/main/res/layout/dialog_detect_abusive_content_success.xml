<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_and_white_dialog"
    android:paddingVertical="24dp"
    android:paddingHorizontal="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tv_detect_abusive_content_success_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="소중한 편지가\n무사히 전송되었어요"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_detect_abusive_success"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        app:shapeAppearanceOverlay="@style/Circle"
        app:cardBackgroundColor="@color/brand"
        app:contentPaddingTop="23.3dp"
        app:contentPaddingLeft="13.22dp"
        app:contentPaddingRight="21.46dp"
        app:contentPaddingBottom="16.68dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_detect_abusive_content_success_title"
        app:layout_constraintStart_toStartOf="@id/tv_detect_abusive_content_success_title"
        app:layout_constraintEnd_toEndOf="@id/tv_detect_abusive_content_success_title">
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/img_send"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_detect_abusive_success"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        tools:text="잉크 1 획득!"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/brand"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/cv_detect_abusive_success"
        app:layout_constraintStart_toStartOf="@id/cv_detect_abusive_success"
        app:layout_constraintEnd_toEndOf="@id/cv_detect_abusive_success"/>

</androidx.constraintlayout.widget.ConstraintLayout>