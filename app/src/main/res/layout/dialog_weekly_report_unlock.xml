<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_and_white_dialog"
    android:paddingVertical="24dp"
    android:paddingHorizontal="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_weekly_report_unlock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="주간 리포트를 보시겠어요?"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_weekly_report_unlock_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잉크 또는 광고 시청을 통해\n열람할 수 있어요"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_weekly_report_unlock_title"
        app:layout_constraintStart_toStartOf="@id/tv_weekly_report_unlock_title"
        app:layout_constraintEnd_toEndOf="@id/tv_weekly_report_unlock_title"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_weekly_report_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/Circle"
        app:layout_constraintTop_toBottomOf="@id/tv_weekly_report_unlock_description"
        app:layout_constraintStart_toStartOf="@id/tv_weekly_report_unlock_description"
        app:layout_constraintEnd_toEndOf="@id/tv_weekly_report_unlock_description">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:paddingStart="12.5dp"
            android:paddingEnd="16.5dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ink_icon"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="10"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_weekly_report_unlock_use_ink"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/neutral"
        android:text="잉크 사용"
        android:textColor="@color/layer_white"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/cv_weekly_report_unlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_weekly_report_unlock_watch_add"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_weekly_report_unlock_watch_add"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/neutral"
        android:text="광고 보기"
        android:textColor="@color/layer_white"
        android:layout_marginStart="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="4dp"
        app:layout_constraintTop_toTopOf="@id/btn_weekly_report_unlock_use_ink"
        app:layout_constraintStart_toEndOf="@id/btn_weekly_report_unlock_use_ink"
        app:layout_constraintBottom_toBottomOf="@id/btn_weekly_report_unlock_use_ink"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>