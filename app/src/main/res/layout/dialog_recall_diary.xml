<?xml version="1.0" encoding="utf-8"?>
<!-- 과거의 나 돌아보기 팝업 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_recall_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:contentDescription="@string/recall_diary_close"
        android:src="@drawable/ic_white_close" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/dialog_background"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_recall_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arita_semibold"
            android:gravity="center"
            android:text="@string/recall_diary_title"
            android:textColor="@color/neutral"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_recall_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/arita_medium"
            android:gravity="center"
            android:text="@string/recall_diary_subtitle"
            android:textColor="@color/neutral"
            android:textSize="12sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arita_medium"
                android:textColor="@color/cos_black"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/type_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/type_layout" />

            <LinearLayout
                android:id="@+id/type_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@id/tv_time"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_emotion"
                    android:layout_width="46dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_tag_emotion"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/recall_diary_type_emotion"
                    android:textColor="@color/dark_bage_text" />

                <TextView
                    android:id="@+id/tv_worry"
                    android:layout_width="46dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_tag_emotion"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/recall_diary_type_concern"
                    android:textColor="@color/dark_bage_text" />

                <TextView
                    android:id="@+id/tv_praise"
                    android:layout_width="46dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_tag_emotion"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/recall_diary_type_praise"
                    android:textColor="@color/dark_bage_text" />

                <TextView
                    android:id="@+id/tv_thanks"
                    android:layout_width="46dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_tag_emotion"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/recall_diary_type_gratitude"
                    android:textColor="@color/dark_bage_text" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_emotion"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/type_layout"
                app:shapeAppearanceOverlay="@style/Circle" />

            <TextView
                android:id="@+id/tv_diary_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:breakStrategy="high_quality"
                android:ellipsize="end"
                android:fontFamily="@font/arita_medium"
                android:includeFontPadding="false"
                android:lineHeight="20sp"
                android:maxLines="4"
                android:textColor="@color/cos_black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/type_layout"
                app:layout_constraintTop_toBottomOf="@id/type_layout" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E9E6D6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_recall_write"
                style="@style/DeleteButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/recall_diary_write_today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_recall_view"
                style="@style/GreenButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/recall_diary_view"
                android:textSize="12sp"
                app:cornerRadius="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
