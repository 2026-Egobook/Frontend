<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.diary.DiaryFragment"
    android:background="@color/white">

    <!--상단 날짜 및 내보내기, 달력 버튼 배치용 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/light_grass"
        android:paddingBottom="12dp">

        <!-- 년/월/일 그룹-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="23.5dp"
            android:layout_marginTop="12dp">

            <!-- 1. 년, 월 -->
            <LinearLayout
                android:id="@+id/year_month_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025"
                    android:textSize="14sp"
                    android:fontFamily="@font/arita_semibold"/>

                <Space
                    android:layout_width="14dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tv_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12월"
                    android:textSize="14sp"
                    android:fontFamily="@font/arita_semibold"/>
            </LinearLayout>

            <!-- 2. 날짜(일) 및 아이콘 -->
            <LinearLayout
                android:id="@+id/date_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_left" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="10"
                    android:textSize="24sp"
                    android:fontFamily="@font/arita_semibold"
                    android:layout_marginHorizontal="16dp"/> <!-- 숫자 양옆 간격 추가 -->

                <ImageView
                    android:id="@+id/btn_next_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_right"/>
            </LinearLayout>

        </LinearLayout>

        <!--내보내기 및 달력 버튼-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingTop="23dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/btn_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_export"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/btn_calender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_calendar"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 탭 레이아웃 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tb_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:tabIndicatorColor="@color/brand_grass"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="@color/cos_black"
        app:tabTextColor="@color/grey"
        app:tabTextAppearance="arita"
        android:background="@color/white">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="감정" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="고민" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="칭찬" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="감사" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 탭 아래 얇은 구분선 -->
    <View
        android:id="@+id/tab_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toBottomOf="@id/tb_type"
        app:layout_constraintStart_toStartOf="@id/tb_type"
        app:layout_constraintEnd_toEndOf="@id/tb_type"/>
    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_diary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_diary"
        app:layout_constraintTop_toBottomOf="@+id/tab_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingStart="16.75dp"
        android:paddingEnd="17.75dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>