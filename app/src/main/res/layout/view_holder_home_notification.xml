<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cl_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_notification_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/ic_unread_letter_notification" />

    <TextView
        android:id="@+id/tv_notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/iv_notification_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_notification_icon"
        app:layout_constraintStart_toEndOf="@id/iv_notification_icon"
        android:text="편지 답장이 도착했어요"
        android:fontFamily="@font/arita_semibold"
        android:textSize="14dp" />

    <TextView
        android:id="@+id/tv_notification_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_notification_title"
        app:layout_constraintStart_toStartOf="@id/tv_notification_title"
        android:text="답장에 관한 내용이 들어가는 자리"
        android:fontFamily="@font/arita_medium"
        android:layout_marginTop="4dp"
        android:textSize="14dp" />

    <TextView
        android:id="@+id/tv_notification_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_notification_content"
        app:layout_constraintStart_toStartOf="@id/tv_notification_title"
        android:text="24시간 전"
        android:fontFamily="@font/arita_medium"
        android:layout_marginTop="4dp"
        android:textSize="14dp" />
    
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/green_secondary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_notification_time" />


</androidx.constraintlayout.widget.ConstraintLayout>
